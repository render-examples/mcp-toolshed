PORT=3000
DATABASE_URL=postgresql://toolshed:toolshed@localhost:5433/toolshed
# TOOLSHED_DB_POOL_MAX=10
# TOOLSHED_DB_QUERY_TIMEOUT_MS=10000
# TOOLSHED_DB_STATEMENT_TIMEOUT_MS=10000
# TOOLSHED_MIGRATION_LOCK_TIMEOUT_MS=30000

# Inserted only when api_keys is empty. Unset after the first deploy.
TOOLSHED_BOOTSTRAP_API_KEY=dev-toolshed-key-change-me

# Optional staging/live-RBAC test keys (inserted by db:migrate when set)
# TOOLSHED_KEY_ANALYST=
# TOOLSHED_KEY_IMPLEMENTER=

# Allow /ready when zero providers loaded (local dev without credentials)
# TOOLSHED_ALLOW_EMPTY=true

# Requests with Origin are rejected unless listed. Add custom domains to hosts.
# TOOLSHED_ALLOWED_ORIGINS=https://app.example.com
# TOOLSHED_ALLOWED_HOSTS=tools.example.com

# --- Provider credentials (omit to disable a provider) ---

# Render MCP passthrough
RENDER_API_KEY=
RENDER_MCP_URL=https://mcp.render.com/mcp

# Official hosted GitHub MCP (PAT authentication)
GITHUB_TOKEN=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# Slack Web API adapter
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
# SLACK_CHANNEL_IDS=C01234567,C76543210

# Custom inline provider stub
TICKET_API_URL=
TICKET_API_KEY=

# Audit retention and payload bounds
TOOLSHED_AUDIT_RETENTION_DAYS=30
TOOLSHED_AUDIT_MAX_ARGUMENT_BYTES=65536
# TOOLSHED_AUDIT_CLEANUP_BATCH_SIZE=5000
# TOOLSHED_AUDIT_CLEANUP_MAX_BATCHES=100
# TOOLSHED_AUDIT_STALE_MINUTES=10
